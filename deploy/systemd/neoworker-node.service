[Unit]
Description=NeoWorker (Node-Only, Headless)
After=network.target

[Service]
Type=simple

# Path where you cloned/built NeoWorker on the VPS.
WorkingDirectory=/opt/neoworker

# Optional env file (LLM keys, data dir, control plane host/port, etc).
EnvironmentFile=-/etc/neoworker.env

# Node-only daemon: no Electron/Xvfb required.
ExecStart=/usr/bin/node /opt/neoworker/bin/neoworkerd-node.js

Restart=on-failure
RestartSec=5

# Run as an unprivileged user (recommended).
User=neoworker
Group=neoworker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
ReadWritePaths=/var/lib/neoworker /srv/neoworker/workspace

[Install]
WantedBy=multi-user.target
