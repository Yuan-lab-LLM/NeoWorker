+package hook
+
+import (
+	"testing"
+
+	"github.com/perplexityai/numbat/internal/model"
+)
+
+func TestNeoWorkerLifecycleAndSourceIdentity(t *testing.T) {
+	lifecycle, err := ResolveLifecycle(AgentNeoWorker, "pre-tool")
+	if err != nil {
+		t.Fatalf("ResolveLifecycle: %v", err)
+	}
+	if lifecycle != LifecycleCodexPreTool {
+		t.Fatalf("lifecycle = %q, want %q", lifecycle, LifecycleCodexPreTool)
+	}
+	source, err := ParseAgent(AgentNeoWorker)
+	if err != nil {
+		t.Fatalf("ParseAgent: %v", err)
+	}
+	if source != model.AgentNeoWorker {
+		t.Fatalf("source = %q, want %q", source, model.AgentNeoWorker)
+	}
+	event := Map(lifecycle, AgentNeoWorker, source, "event-1", map[string]any{
+		"hook_event_name": "PreToolUse",
+		"session_id":      "task-1",
+		"cwd":             "/workspace",
+		"tool_name":       "run_command",
+		"tool_class":      "shell",
+		"tool_input": map[string]any{
+			"command": "go test ./...",
+		},
+	})
+	if event.SourceAgent != model.AgentNeoWorker {
+		t.Fatalf("source_agent = %q, want %q", event.SourceAgent, model.AgentNeoWorker)
+	}
+	if event.EventType != model.EventCommandExec || event.Command != "go test ./..." {
+		t.Fatalf("event = %+v", event)
+	}
+}
+
+func TestNeoWorkerControlResponses(t *testing.T) {
+	allow := PassthroughResponse(AgentNeoWorker, LifecycleCodexPreTool)
+	if allow["protocol_version"] != "neoworker/numbat-hook/v1" ||
+		allow["decision"] != "no_override" ||
+		allow["health"] != "ok" {
+		t.Fatalf("allow = %#v", allow)
+	}
+	deny, ok := DenyResponse(AgentNeoWorker, "blocked")
+	if !ok ||
+		deny["protocol_version"] != "neoworker/numbat-hook/v1" ||
+		deny["decision"] != "deny" ||
+		deny["reason"] != "blocked" {
+		t.Fatalf("deny = %#v, %t", deny, ok)
+	}
+	if !EnforceEligible(AgentNeoWorker, "pre-tool", LifecycleCodexPreTool) {
+		t.Fatal("neoworker pre-tool must be enforceable")
+	}
+}

