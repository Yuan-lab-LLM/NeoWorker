+// classifyNeoWorkerTool maps NeoWorker's deliberately minimal action projection.
+// The host never forwards arbitrary tool inputs; tool_class and the bounded
+// tool_input object are the complete live-inspection contract.
+func classifyNeoWorkerTool(ev *model.Event, r *resolver, post bool) {
+	name := r.toolName()
+	ev.ToolName = name
+	class := strings.ToLower(r.envStr("tool_class"))
+	input := r.toolInput()
+	if post && class != "shell" {
+		mapToolResult(ev, name)
+		if r.toolErrored() {
+			ev.Tags = append(ev.Tags, model.TagToolError)
+		}
+		return
+	}
+	switch class {
+	case "shell":
+		ev.Command = firstString(input, "command")
+		if post {
+			ev.EventType = model.EventCommandResult
+			if code, ok := r.exitCode(); ok {
+				ev.ExitCode = &code
+			}
+			if ms, ok := r.durationMs(); ok {
+				ev.DurationMs = &ms
+			}
+		} else {
+			ev.EventType = model.EventCommandExec
+		}
+	case "file_read":
+		ev.EventType = model.EventFileRead
+		ev.FilePath = firstString(input, "path")
+	case "file_write":
+		ev.EventType = model.EventFileWrite
+		ev.FilePath = firstString(input, "path")
+	case "file_delete":
+		ev.EventType = model.EventFileDelete
+		ev.FilePath = firstString(input, "path")
+	case "network":
+		target := firstString(input, "url")
+		ev.EventType = model.EventNetworkIndicator
+		ev.URL = hookNetworkTargetURL(target)
+		ev.ContentPreview = preview(target)
+		ev.Tags = append(ev.Tags, model.TagNetwork)
+	case "mcp":
+		ev.EventType = model.EventToolCall
+		ev.MCPServer = firstString(input, "mcp_server")
+		ev.MCPTool = firstString(input, "mcp_tool")
+	default:
+		if post {
+			ev.EventType = model.EventToolResult
+		} else {
+			ev.EventType = model.EventToolCall
+		}
+	}
+	if post && r.toolErrored() {
+		ev.Tags = append(ev.Tags, model.TagToolError)
+	}
+}
